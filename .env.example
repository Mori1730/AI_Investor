# === Google Gemini (CrewAI 使用的 LLM) ===
# 取得方式：https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# === Serper (Google 搜尋工具，供 Agent 搜尋新聞) ===
# 取得方式：https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# === LINE Messaging API ===
# 取得方式：https://developers.line.biz/ → 建立 Messaging API Channel
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_USER_ID=your_line_user_id_here

# === FinMind (台股籌碼與融資融券資料) ===
# 取得方式：https://finmindtrade.com/ → 註冊後至個人頁面取得 Token
FINMIND_API_KEY=Bearer your_finmind_jwt_token_here

# === MCP Server 連線位址 (預設即可，通常不需修改) ===
MCP_SERVER_URL=http://localhost:8001/sse
